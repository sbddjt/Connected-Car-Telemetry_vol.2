# Reference for PROCESS environment variables. This file is NOT loaded automatically.
# PowerShell example: $env:VEHICLE_FLEET_TELEMETRY_SERVER_URL = "ws://127.0.0.1:8765"
# REDIS_PASSWORD follows Tesla fleet-telemetry. VEHICLE_/SERVER_ names are local extensions.

# Vehicle: collector and WebSocket client use the same buffer/config.
VEHICLE_FLEET_TELEMETRY_CONFIG_PATH=config/vehicle_fleet_telemetry_config.json
VEHICLE_SQLITE_BUFFER_DB_PATH=data/event_buffer.db
VEHICLE_BUFFER_MAX_MESSAGES=5000
VEHICLE_SUMO_CONFIG_PATH=scenario/gangnam/osm.sumocfg
VEHICLE_SUMO_BINARY=sumo-gui
VEHICLE_FLEET_TELEMETRY_SERVER_URL=ws://127.0.0.1:8765
VEHICLE_MAX_IN_FLIGHT_MESSAGES=20
VEHICLE_LIVE_SEND_WEIGHT=3
VEHICLE_ACK_TIMEOUT_SECONDS=45
VEHICLE_RECONNECT_INITIAL_SECONDS=1
VEHICLE_RECONNECT_MAX_SECONDS=30

# Server: receiver and storage consumer share the Kafka connection/topic.
SERVER_FLEET_TELEMETRY_CONFIG_PATH=config/server_fleet_telemetry_config.json
SERVER_FLEET_TELEMETRY_HOST=127.0.0.1
SERVER_FLEET_TELEMETRY_PORT=8765
SERVER_KAFKA_BOOTSTRAP_SERVERS=localhost:29092,localhost:39092,localhost:49092
SERVER_KAFKA_VEHICLE_TOPIC=vehicle-telemetry-v1
SERVER_KAFKA_CONNECTIVITY_TOPIC=vehicle-connectivity-v1
SERVER_KAFKA_ERRORS_TOPIC=vehicle-errors-v1
SERVER_KAFKA_MESSAGE_TIMEOUT_MS=30000
SERVER_KAFKA_STORAGE_CONSUMER_GROUP_ID=telemetry-storage-v1
SERVER_SQLITE_STORAGE_DB_PATH=data/server_telemetry.db

# Optional mTLS; set ALL THREE paths on each side and use wss:// on the vehicle.
# VEHICLE_TLS_CA_FILE=certs/server_ca.pem
# VEHICLE_TLS_CLIENT_CERT_FILE=certs/vehicle_client.pem
# VEHICLE_TLS_CLIENT_KEY_FILE=certs/vehicle_client.key
# SERVER_TLS_CERT_FILE=certs/telemetry_server.pem
# SERVER_TLS_KEY_FILE=certs/telemetry_server.key
# SERVER_TLS_CLIENT_CA_FILE=certs/vehicle_ca.pem

# Redis Dispatcher: Tesla-style Pub/Sub, independent from the Kafka ACK.
# Cache projection and query API use the same connection/cache prefix.
SERVER_REDIS_URL=redis://127.0.0.1:6380/0
SERVER_REDIS_NAMESPACE=telemetry_v2
SERVER_REDIS_CACHE_PREFIX=telemetry:v2:{query}
SERVER_REDIS_SOCKET_TIMEOUT_SECONDS=2
# REDIS_PASSWORD=your-local-redis-password
# SERVER_REDIS_PASSWORD is accepted as a legacy fallback; REDIS_PASSWORD takes precedence.
SERVER_KAFKA_REDIS_CONSUMER_GROUP_ID=telemetry-redis-latest-v1
SERVER_QUERY_API_HOST=127.0.0.1
SERVER_QUERY_API_PORT=8080
